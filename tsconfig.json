{
	"extends": "@tsconfig/node20/tsconfig.json",
	"compilerOptions": {
		"customConditions": ["node"],
		"module": "ES2022",
		"moduleResolution": "Bundler",
		"noImplicitOverride": true,
		"experimentalDecorators": false
	},
	"include": ["src/**/*.ts", "mcp/**/*.ts"],
	"exclude": ["node_modules"]
}
