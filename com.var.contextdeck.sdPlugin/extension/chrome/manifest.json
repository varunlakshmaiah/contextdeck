{
  "manifest_version": 3,
  "name": "ContextDeck",
  "version": "0.5.1",
  "description": "Lets your Stream Deck (ContextDeck plugin) see which website you're on. Talks only to 127.0.0.1.",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "ContextDeck",
    "default_popup": "options.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "116"
}
