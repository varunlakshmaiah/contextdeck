{
	"id": "system",
	"name": "System",
	"level": "system",
	"color": "#D97757",
	"keys": [
		{
			"label": "{{llm}}",
			"sub": "hold: menu",
			"icon": "sparkles",
			"color": "#D97757",
			"action": {
				"type": "overlay",
				"overlay": {
					"title": "AI on selection",
					"keys": [
						{
							"label": "Fix",
							"sub": "grammar",
							"icon": "spell-check",
							"color": "#D97757",
							"action": {
								"type": "llm",
								"input": "selection",
								"output": "paste",
								"prompt": "Fix spelling, grammar and punctuation. Keep my voice, wording and formatting. Return only the corrected text."
							}
						},
						{
							"label": "Rewrite",
							"sub": "3 options",
							"icon": "pen-line",
							"color": "#D97757",
							"action": {
								"type": "llm",
								"input": "selection",
								"output": "choices",
								"prompt": "Rewrite this 3 ways: tighter, warmer, punchier. One version per line."
							}
						},
						{
							"label": "Summarize",
							"icon": "list",
							"color": "#D97757",
							"action": {
								"type": "llm",
								"input": "selection",
								"output": "notify",
								"prompt": "Summarize in 3 short bullet points."
							}
						},
						{
							"label": "Explain",
							"icon": "lightbulb",
							"color": "#D97757",
							"action": {
								"type": "llm",
								"input": "selection",
								"output": "notify",
								"prompt": "Explain this plainly in under 80 words."
							}
						},
						{
							"label": "Translate",
							"sub": "→ English",
							"icon": "languages",
							"color": "#D97757",
							"action": {
								"type": "llm",
								"input": "selection",
								"output": "paste",
								"prompt": "Translate to natural English. If it's already English, translate to Hindi. Return only the translation."
							}
						},
						{
							"label": "Reply",
							"sub": "draft",
							"icon": "reply",
							"color": "#D97757",
							"action": {
								"type": "llm",
								"input": "selection",
								"output": "clipboard",
								"prompt": "Draft a short, friendly reply to this message in my voice: direct, no fluff."
							}
						},
						{
							"label": "Answer",
							"icon": "message-circle-question",
							"color": "#D97757",
							"action": {
								"type": "llm",
								"input": "selection",
								"output": "notify",
								"prompt": "Answer this question concisely."
							}
						},
						{
							"label": "Close",
							"icon": "x",
							"color": "#71717A",
							"action": {
								"type": "closeOverlay"
							}
						}
					]
				}
			},
			"hold": {
				"type": "deckMenu"
			}
		},
		{
			"label": "Screenshot",
			"icon": "scan",
			"action": {
				"type": "keys",
				"keys": "cmd+shift+5",
				"on": {
					"win": {
						"type": "keys",
						"keys": "win+shift+s"
					},
					"linux": {
						"type": "keys",
						"keys": "print"
					}
				}
			}
		},
		{
			"label": "Spotlight",
			"icon": "search",
			"action": {
				"type": "keys",
				"keys": "cmd+space",
				"on": {
					"win": {
						"type": "keys",
						"keys": "win+s"
					},
					"linux": {
						"type": "keys",
						"keys": "alt+f1"
					}
				}
			}
		},
		{
			"label": "Mission",
			"sub": "Control",
			"icon": "layout-grid",
			"action": {
				"type": "keys",
				"keys": "ctrl+up",
				"on": {
					"win": {
						"type": "keys",
						"keys": "win+tab"
					},
					"linux": {
						"type": "keys",
						"keys": "win+s"
					}
				}
			}
		},
		{
			"label": "Emoji",
			"icon": "smile",
			"action": {
				"type": "keys",
				"keys": "ctrl+cmd+space",
				"on": {
					"win": {
						"type": "keys",
						"keys": "win+."
					},
					"linux": {
						"type": "keys",
						"keys": "ctrl+."
					}
				}
			}
		},
		{
			"label": "Sleep",
			"sub": "display",
			"icon": "moon",
			"action": {
				"type": "shell",
				"cmd": "pmset displaysleepnow",
				"on": {
					"win": {
						"type": "shell",
						"cmd": "powershell -NoProfile -WindowStyle Hidden -Command \"(Add-Type -MemberDefinition '[DllImport(\\\"user32.dll\\\")] public static extern int SendMessage(int h, int m, int w, int l);' -Name D -PassThru)::SendMessage(-1, 0x0112, 0xF170, 2)\""
					},
					"linux": {
						"type": "shell",
						"cmd": "xset dpms force off 2>/dev/null || busctl --user call org.gnome.Shell /org/gnome/ScreenSaver org.gnome.ScreenSaver SetActive b true"
					}
				}
			}
		},
		{
			"label": "Battery",
			"icon": "battery",
			"info": {
				"source": {
					"type": "command",
					"cmd": [
						"/usr/bin/pmset",
						"-g",
						"batt"
					]
				},
				"extract": "/(\\d+)%/",
				"format": "{{value}}%",
				"progress": {
					"max": 100
				},
				"every": 120,
				"thresholds": [
					{
						"below": 20,
						"color": "#EF4444"
					},
					{
						"below": 40,
						"color": "#FBBF24"
					}
				],
				"on": {
					"win": {
						"source": {
							"type": "command",
							"cmd": [
								"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
								"-NoProfile",
								"-Command",
								"(Get-CimInstance Win32_Battery).EstimatedChargeRemaining"
							]
						},
						"extract": "/(\\d+)/"
					},
					"linux": {
						"source": {
							"type": "file",
							"path": "/sys/class/power_supply/BAT0/capacity"
						},
						"extract": "/(\\d+)/"
					}
				}
			}
		},
		{
			"label": "Lock",
			"icon": "lock",
			"color": "#71717A",
			"hold": {
				"type": "keys",
				"keys": "ctrl+cmd+q",
				"on": {
					"win": {
						"type": "keys",
						"keys": "win+l"
					},
					"linux": {
						"type": "shell",
						"cmd": "loginctl lock-session"
					}
				}
			},
			"sub": "hold"
		}
	],
	"dials": [
		{
			"kind": "volume",
			"label": "Volume",
			"icon": "volume-2",
			"step": 3
		},
		{
			"label": "Apps",
			"icon": "app-window",
			"cw": {
				"type": "keys",
				"keys": "cmd+tab",
				"on": {
					"win": {
						"type": "keys",
						"keys": "alt+tab"
					},
					"linux": {
						"type": "keys",
						"keys": "alt+tab"
					}
				}
			},
			"ccw": {
				"type": "keys",
				"keys": "cmd+shift+tab",
				"on": {
					"win": {
						"type": "keys",
						"keys": "alt+shift+tab"
					},
					"linux": {
						"type": "keys",
						"keys": "alt+shift+tab"
					}
				}
			}
		},
		{
			"label": "Spaces",
			"icon": "columns-3",
			"cw": {
				"type": "keys",
				"keys": "ctrl+right",
				"on": {
					"win": {
						"type": "keys",
						"keys": "win+ctrl+right"
					},
					"linux": {
						"type": "keys",
						"keys": "win+pagedown"
					}
				}
			},
			"ccw": {
				"type": "keys",
				"keys": "ctrl+left",
				"on": {
					"win": {
						"type": "keys",
						"keys": "win+ctrl+left"
					},
					"linux": {
						"type": "keys",
						"keys": "win+pageup"
					}
				}
			},
			"press": {
				"type": "keys",
				"keys": "ctrl+up",
				"on": {
					"win": {
						"type": "keys",
						"keys": "win+tab"
					},
					"linux": {
						"type": "keys",
						"keys": "win+s"
					}
				}
			}
		},
		{
			"label": "Scroll",
			"icon": "mouse",
			"cw": {
				"type": "keys",
				"keys": "down down down"
			},
			"ccw": {
				"type": "keys",
				"keys": "up up up"
			}
		}
	]
}
