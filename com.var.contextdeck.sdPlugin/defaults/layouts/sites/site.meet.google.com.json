{
	"id": "site.meet.google.com",
	"name": "Google Meet",
	"color": "#22C55E",
	"priority": 5,
	"match": {
		"url": "*meet.google.com/*-*"
	},
	"keys": [
		{
			"label": "Mute",
			"icon": "mic-off",
			"color": "#EF4444",
			"action": {
				"type": "keys",
				"keys": "cmd+d"
			}
		},
		{
			"label": "Camera",
			"icon": "video-off",
			"action": {
				"type": "keys",
				"keys": "cmd+e"
			}
		},
		{
			"label": "Raise hand",
			"icon": "hand",
			"action": {
				"type": "keys",
				"keys": "ctrl+cmd+h"
			}
		},
		{
			"label": "Captions",
			"icon": "captions",
			"action": {
				"type": "keys",
				"keys": "c"
			}
		},
		{
			"label": "Note",
			"sub": "action item",
			"icon": "notebook-pen",
			"action": {
				"type": "open",
				"target": "Notes"
			}
		},
		null,
		{
			"label": "Leave",
			"sub": "hold",
			"icon": "phone-off",
			"color": "#EF4444",
			"hold": {
				"type": "keys",
				"keys": "cmd+w"
			}
		}
	],
	"level": "sub"
}
