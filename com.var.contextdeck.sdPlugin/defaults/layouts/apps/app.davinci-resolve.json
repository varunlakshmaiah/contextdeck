						"type": "sequence",
						"steps": [
							{
								"type": "keys",
								"keys": "shift+4"
							},
							{
								"type": "mode",
								"mode": "edit"
							}
						]
					}
				}
			],
			"dials": [
				{
					"label": "Clips",
					"icon": "gallery-horizontal",
					"cw": {
						"type": "keys",
						"keys": "down"
					},
					"ccw": {
						"type": "keys",
						"keys": "up"
					}
				},
				{
					"label": "Frames",
					"icon": "move-horizontal",
					"cw": {
						"type": "keys",
						"keys": "right"
					},
					"ccw": {
						"type": "keys",
						"keys": "left"
					},
					"press": {
						"type": "keys",
						"keys": "space"
					}
				},
				{
					"label": "Zoom",
					"icon": "zoom-in",
					"cw": {
						"type": "keys",
						"keys": "cmd+="
					},
					"ccw": {
						"type": "keys",
						"keys": "cmd+-"
					}
				}
			]
		},
		"deliver": {
			"keys": [
				{
					"label": "Chapters",
					"sub": "from markers",
					"icon": "list-ordered",
					"action": {
						"type": "llm",
						"input": "clipboard",
						"output": "clipboard",
						"prompt": "These are timeline markers or a transcript with timecodes. Write YouTube chapters: first line 00:00, format 'MM:SS Title', 4-10 chapters, short punchy titles. Return only the chapters."
					}
				},
				{
					"label": "Titles",
					"icon": "type",
					"action": {
						"type": "llm",
						"input": "clipboard",
						"output": "choices",
						"prompt": "Write 7 YouTube titles for this video (script or summary in the input). Mix curiosity, clarity and specificity. Under 60 characters each."
					}
				},
				{
					"label": "Description",
					"icon": "align-left",
					"action": {
						"type": "llm",
						"input": "clipboard",
						"output": "clipboard",
						"prompt": "Write a YouTube description for this video: a 2-sentence hook, a short paragraph, then 3-5 relevant hashtags."
					}
				},
				null,
				null,
				{
					"label": "Undo",
					"icon": "undo-2",
					"action": {
						"type": "keys",
						"keys": "cmd+z"
					}
				},
				{
					"label": "◂ Edit",
					"icon": "film",
					"color": "#EF4444",
					"action": {
						"type": "sequence",
						"steps": [
							{
								"type": "keys",
								"keys": "shift+4"
							},
							{
								"type": "mode",
								"mode": "edit"
							}
						]
					}
				}
			]
		}
	},
	"level": "app"
