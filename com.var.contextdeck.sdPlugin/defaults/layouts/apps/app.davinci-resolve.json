					"action": {
						"type": "sequence",
						"steps": [
							{
								"type": "keys",
								"keys": "shift+6"
							},
							{
								"type": "mode",
								"mode": "color"
							}
						]
					}
				}
			],
			"dials": [
				{
					"label": "Frames",
					"icon": "move-horizontal",
					"cw": {
						"type": "keys",
						"keys": "right"
					},
					"ccw": {
						"type": "keys",
						"keys": "left"
					},
					"press": {
						"type": "keys",
						"keys": "space"
					}
				},
				{
					"label": "Edits",
					"icon": "skip-forward",
					"cw": {
						"type": "keys",
						"keys": "down"
					},
					"ccw": {
						"type": "keys",
						"keys": "up"
					}
				},
				{
					"label": "Zoom",
					"icon": "zoom-in",
					"cw": {
						"type": "keys",
						"keys": "cmd+="
					},
					"ccw": {
						"type": "keys",
						"keys": "cmd+-"
					},
					"press": {
						"type": "keys",
						"keys": "shift+z"
					}
				}
			]
		},
		"color": {
			"keys": [
				{
					"label": "Grab Still",
					"icon": "camera",
					"action": {
						"type": "keys",
						"keys": "cmd+alt+g"
					}
				},
				{
					"label": "Serial Node",
					"icon": "git-commit-horizontal",
					"action": {
						"type": "keys",
						"keys": "alt+s"
					}
				},
				{
					"label": "Node On/Off",
					"icon": "power",
					"action": {
						"type": "keys",
						"keys": "cmd+d"
					}
				},
				{
					"label": "Bypass All",
					"icon": "eye-off",
					"action": {
						"type": "keys",
						"keys": "shift+d"
					}
				},
				{
					"label": "Deliver",
					"icon": "rocket",
