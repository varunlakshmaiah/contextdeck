{
	"id": "app.davinci-resolve",
	"name": "Resolve",
	"color": "#EF4444",
	"match": {
		"bundleId": "com.blackmagic-design.DaVinciResolve*"
	},
	"defaultMode": "edit",
	"modes": {
		"edit": {
			"keys": [
				{
					"label": "Blade",
					"sub": "B",
					"icon": "scissors",
					"action": {
						"type": "keys",
						"keys": "b"
					}
				},
				{
					"label": "Select",
					"sub": "A",
					"icon": "mouse-pointer-2",
					"action": {
						"type": "keys",
						"keys": "a"
					}
				},
				{
					"label": "Razor",
					"sub": "at playhead",
					"icon": "split",
					"action": {
						"type": "keys",
						"keys": "cmd+b"
					}
				},
				{
					"label": "Ripple Del",
					"icon": "trash-2",
					"color": "#F87171",
					"action": {
						"type": "keys",
						"keys": "shift+delete"
					}
				},
				{
					"label": "Marker",
					"sub": "M",
					"icon": "bookmark",
					"action": {
						"type": "keys",
						"keys": "m"
					}
				},
				{
					"label": "Snapping",
					"sub": "N",
					"icon": "magnet",
					"action": {
						"type": "keys",
						"keys": "n"
					}
				},
				{
