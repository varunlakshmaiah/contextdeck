							{
								"type": "keys",
								"keys": "shift+8"
							},
							{
								"type": "mode",
								"mode": "deliver"
							}
						]
					}
				},
				{
					"label": "Undo",
					"icon": "undo-2",
					"action": {
						"type": "keys",
						"keys": "cmd+z"
