				"keys": [
					0,
					1,
					2,
					3
				],
				"dials": [
					0,
					1
				]
			},
			"app": {
				"keys": [
					4,
					5,
					6
				],
				"dials": [
					2
				]
			},
			"system": {
				"keys": [
