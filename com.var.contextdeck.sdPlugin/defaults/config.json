// ContextDeck settings. Layouts live in ./layouts/{system,apps,sites,takeovers}/<id>.json (one file each).
// Naming: system | app.<bundleId> | app.<group> | site.<host> | sub.<bundleId>.<name> | takeover.<name>
// Secrets: UPPER_SNAKE (<SERVICE>_API_KEY / _TOKEN / _URL), used as {{secret.NAME}}, stored in the Keychain:  ~/.contextdeck/deck secret set NAME
// AI providers: "llm" = AI keys, "setupLlm" = ✨ Set up, optional "fallbackLlm". Presets: anthropic, openai, openrouter, groq, gemini, mistral, deepseek, xai, together, ollama, lmstudio.
// Research for ✨ Set up: "research.provider" = none | brave | tavily | exa | searxng | openrouter-online (keys: BRAVE_SEARCH_API_KEY, TAVILY_API_KEY, EXA_API_KEY).
{
	"settings": {
		"pollMs": 700,
		"llm": "anthropic",
		"setupLlm": "anthropic",
		"providers": {
			"anthropic": {
				"model": "claude-sonnet-5-5"
			}
		},
		"accent": "#F97316",
		"background": "#111113",
		"holdMs": 500,
		"apiPort": 47811,
		"autoSetup": "key",
		"setupSlot": 6,
		"setupIgnore": [],
