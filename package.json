{
  "name": "contextdeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Context-aware Stream Deck+ plugin: keys and dials redraw for whatever you're doing, with a local API and an MCP bridge for Claude.",
  "scripts": {
    "icons": "node scripts/build-icons.mjs",
    "build": "npm run icons && rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.var.contextdeck\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "validate": "streamdeck validate com.var.contextdeck.sdPlugin",
    "pack": "streamdeck pack com.var.contextdeck.sdPlugin -o dist --force",
    "link": "streamdeck link com.var.contextdeck.sdPlugin"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.3"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@resvg/resvg-js": "^2.6.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@tsconfig/node20": "^20.1.10",
    "@types/node": "^26.6.5",
    "lucide-static": "^1.61.0",
    "rollup": "^4.65.0",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  }
}
