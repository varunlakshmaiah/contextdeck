{
  "name": "contextdeck",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "Context-aware Stream Deck plugin: keys and dials redraw for the app and website in front, set themselves up with AI, and work on macOS, Windows and Linux (OpenDeck).",
  "license": "MIT",
  "author": "Varun Lakshmaiah (https://github.com/varunlakshmaiah)",
  "homepage": "https://github.com/varunlakshmaiah/contextdeck#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/varunlakshmaiah/contextdeck.git"
  },
  "bugs": {
    "url": "https://github.com/varunlakshmaiah/contextdeck/issues"
  },
  "keywords": [
    "stream-deck",
    "elgato",
    "streamdeck-plugin",
    "opendeck",
    "context-aware",
    "macro-pad",
    "llm",
    "claude",
    "mcp",
    "automation",
    "productivity"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "icons": "node scripts/build-icons.mjs",
    "build": "npm run icons && node scripts/build-profiles.mjs && rollup -c && node scripts/build-extension.mjs",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.var.contextdeck\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "validate": "streamdeck validate com.var.contextdeck.sdPlugin",
    "pack": "streamdeck pack com.var.contextdeck.sdPlugin -o dist --force",
    "link": "streamdeck link com.var.contextdeck.sdPlugin",
    "test:e2e": "tsx test/smoke.ts && tsx test/extension.ts && tsx test/ui.ts"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.3"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@resvg/resvg-js": "^2.6.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@tsconfig/node20": "^20.1.10",
    "@types/node": "^26.6.5",
    "lucide-static": "^1.61.0",
    "rollup": "^4.65.0",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
